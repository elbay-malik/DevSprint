{
  "name": "devsprint",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "pnpm -r test && node --test scripts/*.test.ts",
    "eval": "pnpm --filter @devsprint/api eval",
    "build": "pnpm -r --if-present build",
    "prepare": "husky",
    "deploy:all": "node scripts/deploy.ts",
    "smoke": "node scripts/smoke.ts",
    "ci:local": "node scripts/ci-local.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vue/eslint-config-prettier": "catalog:",
    "@vue/eslint-config-typescript": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "husky": "9.1.7",
    "jiti": "catalog:",
    "lint-staged": "17.0.8",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": "eslint --fix",
    "*": "prettier --write --ignore-unknown"
  }
}
