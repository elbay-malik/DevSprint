{
  "name": "@devsprint/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "pnpm run build && wrangler deploy",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@ai-sdk/vue": "catalog:",
    "@devsprint/shared": "workspace:*",
    "@fontsource-variable/geist": "catalog:",
    "@lucide/vue": "catalog:",
    "@vueuse/core": "catalog:",
    "ai": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "pinia": "catalog:",
    "reka-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-sonner": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "catalog:",
    "happy-dom": "catalog:",
    "lighthouse": "13.6.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:",
    "wrangler": "catalog:"
  }
}
