{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devsprint-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Served on its own custom domain, so the zone's rate-limiting rule can sit
  // in front of it (ADR-0019's 2026-11-08 note); workers.dev stays on until the
  // custom domain is proven, then goes off. No version preview URLs: Cloudflare does
  // not generate them for a Worker that defines a Durable Object anyway, and
  // PR previews are the SPA's alone.
  "routes": [{ "pattern": "api.devsprint.elbaymalik.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  // Not needed for the echo route, but standard for the AI SDK providers
  // arriving in Phase 3 — avoids a config change later.
  // enable_request_signal makes a client that disconnects abort the request's
  // signal, so a dropped chat turn stops its agent loop and a deployment it was
  // running settles as cancelled (ADR-0013). It becomes the default with the
  // 2026-11-17 compatibility date; it is set here so this does not wait for a
  // date bump.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "dev": {
    "port": 8787,
  },
  // These are the *deployed* values (ADR-0019); `pnpm dev` and the e2e suite
  // override them with `--var` for localhost. Neither is a secret.
  "vars": {
    // The SPA and its PR preview aliases — see src/cors.ts for the matching. The
    // `pr-` keeps out the hash-named URL every uploaded version gets. These
    // origins may also POST: index.ts refuses a browser write from any other.
    "CORS_ORIGIN": "https://devsprint.elbaymalik.com,https://devsprint-web.eleo-666.workers.dev,https://pr-*-devsprint-web.eleo-666.workers.dev",
    // Groq when its key is set, the scripted mock otherwise (ADR-0026). The key
    // is a Worker secret. `mock` puts the demo back on the scripted
    // model, which spends nothing.
    "MODEL_PROVIDER": "auto",
    // One visitor reset per 30 seconds for the whole board (ADR-0024). The
    // e2e stack passes 0, because it resets before every test.
    "RESET_COOLDOWN_SECONDS": "30",
  },
  // Per-IP throttle on the chat route (ADR-0016). 60/minute is far above any
  // human session and far below what a crawler does, and the binding's own
  // looseness — permissive, eventually consistent, per Cloudflare location —
  // is fine for that job. It is deliberately *not* the spend control: that is
  // the daily token cap and each client's share of it, in the workspace Durable
  // Object, which have to be global and accurate in a way this binding does not
  // claim to be.
  //
  // The second binding throttles undo and deployment cancel, the writes that
  // skip the model. 30 a minute is far more than a person clicks. Reset has a
  // whole-board cooldown instead (ADR-0024).
  //
  // The third throttles the board snapshot the SPA reads (ADR-0024's
  // 2026-11-08 status note). The SPA does not poll: a tab reads on load, after
  // a turn or a button, and on a return at most every 5 s, so about a dozen a
  // minute at the busiest. 300 leaves room for many tabs or a shared address.
  "ratelimits": [
    { "name": "CHAT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "WRITE_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "READ_RATE_LIMIT", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } },
  ],
  "observability": {
    "enabled": true,
  },
  // The agent sources its five issue tools from the public MCP server, the same
  // way an external host does (ADR-0002). A service binding keeps that call
  // inside Cloudflare's network rather than going out over the internet.
  // The `Internal` entrypoint, so the agent's MCP calls never share the public
  // endpoint's per-IP limit (ADR-0020).
  "services": [
    { "binding": "MCP_ISSUES", "service": "devsprint-mcp-issues", "entrypoint": "Internal" },
  ],
  // The one copy of the workspace. It lives here, and the MCP servers bind it
  // cross-script, so both clients see the same board (scenario S-F).
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "WorkspaceDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] }],
}
