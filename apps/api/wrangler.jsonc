{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devsprint-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Not needed for the echo route, but standard for the AI SDK providers
  // arriving in Phase 3 — avoids a config change later.
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8787,
  },
  "vars": {
    // Build-config var, not a secret. Must be updated to the deployed web
    // origin before a real deploy — see README.md runbook.
    "CORS_ORIGIN": "http://localhost:5173",
  },
  // Per-IP throttle on the chat route (ADR-0016). 60/minute is far above any
  // human session and far below what a crawler does, and the binding's own
  // looseness — permissive, eventually consistent, per Cloudflare location —
  // is fine for that job. It is deliberately *not* the spend control: that is
  // the daily token cap in the workspace Durable Object, which has to be
  // global and accurate in a way this binding does not claim to be.
  "ratelimits": [
    { "name": "CHAT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],
  "observability": {
    "enabled": true,
  },
  // The agent sources its four issue tools from the public MCP server, the same
  // way an external host does (ADR-0002). A service binding keeps that call
  // inside Cloudflare's network rather than going out over the internet.
  "services": [{ "binding": "MCP_ISSUES", "service": "devsprint-mcp-issues" }],
  // The one copy of the workspace. It lives here, and the MCP servers bind it
  // cross-script, so both clients see the same board (scenario S-F).
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "WorkspaceDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] }],
}
