{
  "name": "@devsprint/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var CORS_ORIGIN:http://localhost:5173",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "vitest run src/evals"
  },
  "dependencies": {
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/mcp": "catalog:",
    "@ai-sdk/groq": "catalog:",
    "@devsprint/shared": "workspace:*",
    "ai": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
