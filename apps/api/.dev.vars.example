# Copy to .dev.vars (gitignored) — wrangler dev loads it automatically.
# With no keys set the api falls back to a scripted mock model, so the whole
# app still runs end to end without spending provider quota.

# auto | groq | gemini | mock. wrangler.jsonc sets `auto`, which uses whichever
# keys are present and falls back to the scripted mock when there are none —
# so a fresh clone runs on the mock, and adding a key below switches it over.
# MODEL_PROVIDER=auto

# Primary provider (ADR-0005). https://console.groq.com/keys
# GROQ_API_KEY=

# Fallback provider (ADR-0005). https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=

# Model id overrides — defaults shown.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.8-flash

# Signs tool approvals so a forged one cannot execute a write. Unset falls back
# to a random per-isolate secret (fine locally, set a real one before deploying).
# TOOL_APPROVAL_SECRET=

# Tracing (ADR-0015). Both keys must be set or tracing never installs — with
# neither, the app runs with no network and no account, like the mock model.
# Traces are exported as OTLP/HTTP JSON after the turn's response has streamed.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Region or self-hosted instance. Default: https://cloud.langfuse.com
# LANGFUSE_HOST=https://us.cloud.langfuse.com
# Tags traces with the environment they came from.
# DEVSPRINT_ENV=local

# Model tokens the demo may spend per UTC day before it degrades into the
# "budget reached" state (ADR-0016). Default: 100000, matching Groq's free
# tier. Set 0 to disable. The scripted mock is always exempt — it spends
# nothing, so local dev and CI are never rationed.
# DAILY_TOKEN_CAP=100000
