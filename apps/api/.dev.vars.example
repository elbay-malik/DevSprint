# Copy to .dev.vars (gitignored) — wrangler dev loads it automatically.
# With no keys set the api falls back to a scripted mock model, so the whole
# app still runs end to end without spending provider quota.

# auto | groq | gemini | mock  (default: auto)
# MODEL_PROVIDER=auto

# Primary provider (ADR-0005). https://console.groq.com/keys
# GROQ_API_KEY=

# Fallback provider (ADR-0005). https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=

# Model id overrides — defaults shown.
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash

# Signs tool approvals so a forged one cannot execute a write. Unset falls back
# to a random per-isolate secret (fine locally, set a real one before deploying).
# TOOL_APPROVAL_SECRET=
