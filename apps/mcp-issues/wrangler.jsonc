{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devsprint-mcp-issues",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // The public MCP endpoint for scenario S-F, on its own custom domain so the
  // zone's rate-limiting rule covers it (ADR-0019's 2026-11-08 note). A preview version of
  // this Worker would write to the production board, so it has none.
  "routes": [{ "pattern": "mcp.devsprint.elbaymalik.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8788,
    // Distinct from the api Worker's default 9229: `pnpm dev` runs both, and
    // two wrangler processes cannot share one inspector port.
    "inspector_port": 9230,
  },
  "observability": {
    "enabled": true,
  },
  // The workspace Durable Object is defined in the api Worker; this binds the
  // same class cross-script so both Workers see one board. Locally that means
  // `devsprint-api` must be running too — `pnpm dev` starts both.
  // Per-IP throttle on the public /mcp endpoint (ADR-0020). 30 a minute is
  // several times what an MCP host uses in a session. It slows a flood rather
  // than stopping one: what keeps the board usable is the day's cap on new
  // issues (workspace/mutations.ts) and refusing JSON-RPC batches, which would
  // otherwise carry many calls on one token (src/index.ts). The in-app agent
  // comes in through the `Internal` entrypoint and is not counted.
  "ratelimits": [
    { "name": "MCP_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "WorkspaceDO", "script_name": "devsprint-api" },
    ],
  },
}
